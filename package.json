{
  "name": "cordova-plugin-geofence",
  "version": "0.8.1",
  "description": "Cordova geofence plugin",
  "cordova": {
    "id": "cordova-plugin-geofence",
    "platforms": [
      "android",
      "ios"
    ]
  },
  "scripts": {
    "lint": "jshint -c tests/.jshintrc tests/android-webhook-hardening.test.js tests/ios-permission-contract.test.js",
    "test:js": "node tests/android-security-port.test.js && node tests/android-permission-concurrency.test.js && node tests/android-coordinator-debounce.test.js && node tests/ios-transition-persistence.test.js && node tests/contract-notification-name.test.js && node tests/android-webhook-hardening.test.js && node tests/ios-permission-contract.test.js",
    "test:android": "cordova-paramedic --platform android --plugin . --verbose",
    "test:ios": "cordova-paramedic --platform ios --plugin . --verbose",
    "pack:check": "npm pack --dry-run",
    "test": "npm run lint && npm run test:js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tgptom/cordova-plugin-geofence.git"
  },
  "keywords": [
    "cordova",
    "plugin",
    "geofence",
    "ecosystem:cordova",
    "cordova-android",
    "cordova-ios"
  ],
  "author": "Cowbell Labs",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/tgptom/cordova-plugin-geofence/issues"
  },
  "homepage": "https://github.com/tgptom/cordova-plugin-geofence#readme",
  "engines": [
    {
      "name": "cordova",
      "version": ">=5.0.0"
    }
  ],
  "typings": "./typings/cordova-plugin-geofence.d.ts",
  "devDependencies": {
    "cordova": "^12.0.0",
    "cordova-android": "^13.0.0",
    "cordova-ios": "^7.1.0",
    "jshint": "^2.13.6",
    "cordova-paramedic": "https://github.com/apache/cordova-paramedic"
  }
}
