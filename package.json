{
  "name": "cordova-plugin-geofence",
  "version": "0.8.1",
  "description": "Cordova geofence plugin",
  "cordova": {
    "id": "cordova-plugin-geofence",
    "platforms": [
      "android",
      "ios",
      "windows"
    ]
  },
  "scripts": {
    "test:unit": "node tests/android-permission-concurrency.test.js && node tests/android-security-port.test.js && node tests/android-coordinator-debounce.test.js && node tests/ios-transition-persistence.test.js && node tests/contract-notification-name.test.js",
    "test:paramedic:android": "cordova-paramedic --platform android --plugin . --verbose",
    "test:paramedic:ios": "cordova-paramedic --platform ios --plugin . --verbose",
    "test": "npm run test:unit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cowbell/cordova-plugin-geofence.git"
  },
  "keywords": [
    "cordova",
    "plugin",
    "geofence",
    "ecosystem:cordova",
    "cordova-android",
    "cordova-ios",
    "cordova-wp8",
    "cordova-windows8",
    "cordova-windows"
  ],
  "author": "Cowbell Labs",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/cowbell/cordova-plugin-geofence/issues"
  },
  "homepage": "https://github.com/cowbell/cordova-plugin-geofence#readme",
  "engines": {
    "cordova": ">=12.0.0",
    "cordova-android": ">=12.0.0",
    "cordova-ios": ">=8.0.0",
    "node": ">=18.0.0"
  },
  "typings": "./typings/cordova-plugin-geofence.d.ts",
  "devDependencies": {
    "cordova": "^12.0.0",
    "cordova-paramedic": "https://github.com/apache/cordova-paramedic"
  }
}
